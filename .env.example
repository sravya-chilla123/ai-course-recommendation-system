# Environment Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database: MongoDB Atlas connection string (or leave empty for seamless in-memory fallback)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pathpilot?retryWrites=true&w=majority

# Authentication
JWT_SECRET=pathpilot_super_secure_jwt_secret_key_2026_production

# Optional Gemini API Key (Backend uses rule-based AI engine fallback if not provided)
GEMINI_API_KEY=your_optional_gemini_api_key_here
